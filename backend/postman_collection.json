{
  "info": {
    "name": "Wooloo | Hito 2 | Demo y verificación",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecuta las carpetas en orden. Las peticiones de creación guardan un ID o una clave para el resto del recorrido."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:43101"
    },
    {
      "key": "tripId",
      "value": ""
    },
    {
      "key": "placeKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Inicio",
      "item": [
        {
          "name": "Salud",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Viajes",
      "item": [
        {
          "name": "Crear viaje",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trips",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ruta al sur\",\n  \"destKey\": \"osorno\",\n  \"departureISO\": \"2030-12-15T08:00:00.000Z\",\n  \"stops\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"tripId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar viaje",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trips/{{tripId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Agregar Chillán",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trips/{{tripId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ruta al sur\",\n  \"destKey\": \"osorno\",\n  \"departureISO\": \"2030-12-15T08:00:00.000Z\",\n  \"stops\": [\n    {\n      \"key\": \"chillan\",\n      \"stayMin\": 30\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar dato guardado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trips/{{tripId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Chillán persistido\", () => pm.expect(pm.response.json().data.stops[0].key).to.eql(\"chillan\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Borrar viaje",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/trips/{{tripId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Comprobar borrado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trips/{{tripId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Catálogo",
      "item": [
        {
          "name": "Crear ubicación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/catalog",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{placeKey}}\",\n  \"name\": \"Mirador ficticio\",\n  \"lat\": -40.5,\n  \"lng\": -73,\n  \"icon\": \"Pin\",\n  \"description\": \"Lugar de prueba\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"placeKey\", \"mirador-demo-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar ubicación",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/{{placeKey}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar ubicación",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/catalog/{{placeKey}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{placeKey}}\",\n  \"name\": \"Mirador ficticio actualizado\",\n  \"lat\": -40.5,\n  \"lng\": -73,\n  \"icon\": \"Pin\",\n  \"description\": \"Lugar de prueba\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar dato guardado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/{{placeKey}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Nombre persistido\", () => pm.expect(pm.response.json().data.name).to.eql(\"Mirador ficticio actualizado\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Borrar ubicación",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/{{placeKey}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Comprobar borrado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/{{placeKey}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 · Pedido inválido",
      "item": [
        {
          "name": "Latitud fuera de rango",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/catalog",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"prueba-invalida\",\n  \"name\": \"Mirador ficticio\",\n  \"lat\": 95,\n  \"lng\": -73,\n  \"icon\": \"Pin\",\n  \"description\": \"Lugar de prueba\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
